# Threads Monitor — copy to .env (php artisan threads:install does this for you).
# Project keys are explained in docs/SELF-HOSTING.md, Appendix A ".env keys explained".
# Keys not listed there are standard Laravel settings; keep their defaults.
# Only placeholder values belong in this file.

APP_NAME="Threads Monitor"
APP_ENV=production
# Filled in by `php artisan threads:install` (or `php artisan key:generate`). Never share it.
APP_KEY=
APP_DEBUG=false
# The public address of your installation, e.g. https://threads.example.com
APP_URL=http://localhost

# Interface language when the visitor has not picked one with the header switch and the browser
# does not ask for one (Accept-Language): en (English) or zh_TW (Traditional Chinese).
APP_LOCALE=en
# Used for any text missing in the chosen language. Keep it en.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Default: SQLite, stored in database/database.sqlite (leave DB_DATABASE commented out).
DB_CONNECTION=sqlite
# Optional MySQL 8 instead (see docs/SELF-HOSTING.md, section 3 "Optional: use MySQL"):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=threads_monitor
# DB_USERNAME=threads_monitor
# DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Send the session cookie over HTTPS only. The installer sets it to true when APP_URL starts
# with https://; leave it unset (or false) for plain-http local tries, or logging in fails.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Threads tracker (see config/threads.php and docs/HOW-IT-WORKS.md)
THREADS_USER_AGENT="Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)"
THREADS_TIMEOUT=30
THREADS_TRACK_HOURS=72
# Fetch schedule after publish: "from-to:minutes" bands, comma separated. Empty = every 60 minutes
# from 0 to 72 hours. To fetch less often (lower risk of being blocked), e.g. hourly for the first
# day, then every 3 hours: THREADS_POLL_BANDS=0-24:60,24-72:180
THREADS_POLL_BANDS=
THREADS_MAX_CONSECUTIVE_FAILURES=5
THREADS_RETRY_MINUTES=15
THREADS_POLITENESS_SLEEP_MS=3000
THREADS_SNAPSHOT_RAW_RETENTION_DAYS=7
THREADS_DISPLAY_TIMEZONE=Asia/Taipei

# Footer credit line on every web page. Uncomment to turn it off or replace it with your own
# text / link (the link must start with http:// or https://; leave it empty to show text only).
# THREADS_FOOTER_ENABLED=false
# THREADS_FOOTER_TEXT="Powered by Your Name"
# THREADS_FOOTER_URL=https://example.com/
